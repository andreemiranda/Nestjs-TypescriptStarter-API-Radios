# ==============================================================================
# RADIOSWAVE API - ARQUIVO DE CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================

# Ambiente de execução ('development', 'production', 'test')
NODE_ENV=production

# Porta do servidor HTTP (padrão: 3000)
PORT=3000

# Chave secreta de autenticação da API (OBRIGATÓRIO EM PRODUÇÃO)
# Aceita no cabeçalho 'X-API-Key' ou na query string '?API_KEY=<chave>'
# Gere uma chave segura com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Origens permitidas para requisições CORS
# Padrão: '*' (todas) ou lista separada por vírgula (ex: https://meusite.com,https://app.meusite.com)
CORS_ORIGIN=*

# Rate Limiting (Controle de Frequência contra ataques de Força Bruta e DoS)
# THROTTLE_TTL: Janela de tempo em milissegundos (padrão: 60000 = 60 segundos)
THROTTLE_TTL=60000
# THROTTLE_LIMIT: Máximo de requisições permitidas por IP dentro da janela (padrão: 120)
THROTTLE_LIMIT=120

# Habilitação da interface interativa Swagger UI ('true' ou 'false', padrão: 'true')
SWAGGER_ENABLED=true

# Caminho customizado para o arquivo radios.json (OPCIONAL)
# Se não for definido, o servidor resolve automaticamente entre src/database ou dist/database
# RADIOS_DB_PATH=/caminho/personalizado/radios.json
