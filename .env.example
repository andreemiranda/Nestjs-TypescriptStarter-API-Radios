# ==============================================================================
# RADIOSWAVE API - ARQUIVO DE CONFIGURACAO DE VARIAVEIS DE AMBIENTE (.env)
# ==============================================================================

# Ambiente de execucao ('development', 'production', 'test')
NODE_ENV=production

# Porta do servidor HTTP (padrao: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# AUTENTICACAO E SEGREDOS
# ------------------------------------------------------------------------------
# Chave primaria de autenticacao da API (OBRIGATORIO EM PRODUCAO, minimo 32 caracteres com alta entropia)
# Gere uma chave segura com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Modelo multi-chaves nomeadas com suporte a rotacao e janela de transicao (formato JSON)
# Exemplo: [{"id":"client-web","name":"Portal Web","key":"...","expiresAt":"2026-12-31T23:59:59Z"}]
# API_KEYS_JSON=

# Permite passagem de chave por query string (?API_KEY= ou ?api_key=)
# Padrao seguro em producao: false (desabilita exposicao em logs/historico/referer)
ALLOW_QUERY_API_KEY=false

# ------------------------------------------------------------------------------
# CONTROLE DE ORIGENS (CORS)
# ------------------------------------------------------------------------------
# Origens permitidas para requisicoes entre dominios (CORS)
# Em producao, NUNCA utilize asterisco (*). Defina dominios especificos separados por virgula:
CORS_ORIGIN=https://radioswave.netlify.app

# ------------------------------------------------------------------------------
# RATE LIMITING E PROTECAO CONTRA FORCA BRUTA
# ------------------------------------------------------------------------------
# Rate limiting geral: Janela em milissegundos (padrao: 60000 = 60 segundos)
THROTTLE_TTL=60000

# Rate limiting geral: Maximo de requisicoes por IP dentro da janela (padrao: 120)
THROTTLE_LIMIT=120

# Protecao contra forca bruta em autenticacao: Maximo de falhas permitidas antes de bloquear o IP
AUTH_FAIL_LIMIT=10

# Tempo de bloqueio (em segundos) apos atingir o limite de falhas de autenticacao (padrao: 300 = 5 min)
AUTH_FAIL_TTL_SEC=300

# ------------------------------------------------------------------------------
# SWAGGER E DOCUMENTACAO
# ------------------------------------------------------------------------------
# Em producao, o Swagger deve permanecer desabilitado ('false') por padrao
SWAGGER_ENABLED=false

# Credenciais para protecao via HTTP Basic Auth quando o Swagger for habilitado em producao
SWAGGER_USER=
SWAGGER_PASSWORD=

# ------------------------------------------------------------------------------
# INFRAESTRUTURA E DADOS
# ------------------------------------------------------------------------------
# Quantidade de saltos de proxy reverso confiaveis ('1' para Vercel / Cloud Run / Nginx)
TRUST_PROXY=1

# Tempo limite maximo para execucao de requisicoes em milissegundos (padrao: 15000 = 15s)
REQUEST_TIMEOUT_MS=15000

# Caminho customizado para o arquivo radios.json (restrito ao diretorio raiz da aplicacao)
# RADIOS_DB_PATH=src/database/radios.json

# Permite streams de radio sem criptografia (HTTP://). Em producao, recomendado 'false'
ALLOW_INSECURE_HTTP_STREAMS=false
